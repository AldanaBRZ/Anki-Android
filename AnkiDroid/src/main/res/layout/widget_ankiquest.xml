<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ankiquest_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ankiquest_widget_background"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/ankiquest_widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="4dp"
        android:text="@string/ankiquest_widget_title"
        android:textColor="#8B949C"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/ankiquest_widget_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#E8E6E1"
        android:textSize="13sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/ankiquest_widget_row_0"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="4dp"
        android:visibility="gone">
        <TextView android:id="@+id/ankiquest_widget_name_0" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:singleLine="true" android:textColor="#E8E6E1" android:textSize="14sp" />
        <TextView android:id="@+id/ankiquest_widget_level_0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingStart="8dp" android:textColor="#F0B840" android:textSize="14sp" />
        <TextView android:id="@+id/ankiquest_widget_xp_0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="end" android:minWidth="64dp" android:paddingStart="8dp" android:textColor="#5AA5F0" android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ankiquest_widget_row_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="4dp"
        android:visibility="gone">
        <TextView android:id="@+id/ankiquest_widget_name_1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:singleLine="true" android:textColor="#E8E6E1" android:textSize="14sp" />
        <TextView android:id="@+id/ankiquest_widget_level_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingStart="8dp" android:textColor="#F0B840" android:textSize="14sp" />
        <TextView android:id="@+id/ankiquest_widget_xp_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="end" android:minWidth="64dp" android:paddingStart="8dp" android:textColor="#5AA5F0" android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ankiquest_widget_row_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="4dp"
        android:visibility="gone">
        <TextView android:id="@+id/ankiquest_widget_name_2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:singleLine="true" android:textColor="#E8E6E1" android:textSize="14sp" />
        <TextView android:id="@+id/ankiquest_widget_level_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingStart="8dp" android:textColor="#F0B840" android:textSize="14sp" />
        <TextView android:id="@+id/ankiquest_widget_xp_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="end" android:minWidth="64dp" android:paddingStart="8dp" android:textColor="#5AA5F0" android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ankiquest_widget_row_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="4dp"
        android:visibility="gone">
        <TextView android:id="@+id/ankiquest_widget_name_3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:singleLine="true" android:textColor="#E8E6E1" android:textSize="14sp" />
        <TextView android:id="@+id/ankiquest_widget_level_3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingStart="8dp" android:textColor="#F0B840" android:textSize="14sp" />
        <TextView android:id="@+id/ankiquest_widget_xp_3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="end" android:minWidth="64dp" android:paddingStart="8dp" android:textColor="#5AA5F0" android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ankiquest_widget_row_4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="4dp"
        android:visibility="gone">
        <TextView android:id="@+id/ankiquest_widget_name_4" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:singleLine="true" android:textColor="#E8E6E1" android:textSize="14sp" />
        <TextView android:id="@+id/ankiquest_widget_level_4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingStart="8dp" android:textColor="#F0B840" android:textSize="14sp" />
        <TextView android:id="@+id/ankiquest_widget_xp_4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="end" android:minWidth="64dp" android:paddingStart="8dp" android:textColor="#5AA5F0" android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
